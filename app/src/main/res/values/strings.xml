    <string name="mode_title">Mode</string>
    <string name="mode_label">Rotation</string>
    <string name="mode_smart_shuffle">Smart shuffle</string>
    <string name="mode_smart_shuffle_desc">Fair, weighted rotation: every photo appears once before any repeats, and photos shown recently cool down.</string>
    <string name="mode_sequential">Sequential</string>
    <string name="mode_sequential_desc">Walks through your photos in a fixed order. Great for a story or a fixed set.</string>
    <string name="mode_random">Pure random</string>
    <string name="mode_random_desc">A uniform random photo each time, never the same one twice in a row.</string>
    <string name="mode_daily">Daily</string>
    <string name="mode_daily_desc">One photo per day, kept until midnight. Fair rotation decides which one.</string>
    <string name="mode_weekly">Day of week</string>
    <string name="mode_weekly_desc">One fixed photo per weekday, in list order, swapped at midnight. A quiet weekly rhythm.</string>
    <string name="mode_least_shown">Least shown</string>
    <string name="mode_least_shown_desc">Always moves on to the photo that has appeared the fewest times, so no photo gets left behind.</string>
    <string name="mode_collage">Collage</string>
    <string name="mode_collage_desc">Several photos at once in a grid that adapts to the widget’s shape.</string>
    <string name="mode_single">Single photo</string>
    <string name="mode_single_desc">Always shows one photo you choose. No timer.</string>
    <string name="cooldown_title">Cooldown</string>
    <string name="cooldown_value">%1$d%%</string>
    <string name="cooldown_help">Keeps the most recently shown photos out of the next round. Lower values repeat sooner, higher values are stricter.</string>
    <string name="collage_count_title">Photos per collage</string>
