<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 counterpart of data_extraction_rules.xml. Backups are disabled
  (android:allowBackup="false"); these rules state the same exclusion for API 26-30 so
  the intent is explicit on every supported version instead of only on API 31+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
