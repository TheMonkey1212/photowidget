<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups stay disabled (android:allowBackup="false"); these rules make that explicit
  for Android 12+ so nothing is uploaded or transferred to a new device. Photo widget
  data only refers to files that already live on the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
